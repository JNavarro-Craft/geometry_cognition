{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geometry_cognition/contracts/geometry_schema.v2.json",
  "title": "Geometry Schema v2",
  "description": "Extiende v1 con campos opcionales para observacion geometrica avanzada (sin requerir calculo complejo en esta fase).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "bbox",
    "centroid",
    "volume",
    "area",
    "principal_dimensions",
    "aspect_ratios",
    "local_frame",
    "morphology",
    "morphology_confidence",
    "geometric_warnings",
    "derived_from"
  ],
  "properties": {
    "object_id": { "type": "string", "minLength": 1 },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "max": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
      }
    },
    "centroid": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "volume": { "type": ["number", "null"] },
    "area": { "type": ["number", "null"] },
    "principal_dimensions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "aspect_ratios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xy", "xz", "yz"],
      "properties": {
        "xy": { "type": "number" },
        "xz": { "type": "number" },
        "yz": { "type": "number" }
      }
    },
    "local_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "x_axis", "y_axis", "z_axis"],
      "properties": {
        "origin": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "x_axis": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "y_axis": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "z_axis": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
      }
    },
    "morphology": {
      "type": "string",
      "enum": [
        "unknown",
        "linear_prismatic",
        "thin_plate",
        "compact_solid",
        "planar_surface",
        "irregular_solid",
        "repeated_element_candidate"
      ]
    },
    "morphology_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "geometric_warnings": { "type": "array", "items": { "type": "string" } },
    "derived_from": { "type": "array", "items": { "type": "string" } },

    "oriented_bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "axes", "extents"],
      "properties": {
        "center": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "axes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        },
        "extents": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
      }
    },
    "face_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face_count", "dominant_faces", "area_distribution"],
      "properties": {
        "face_count": { "type": "integer", "minimum": 0 },
        "dominant_faces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["face_id", "area", "normal"],
            "properties": {
              "face_id": { "type": "string" },
              "area": { "type": "number", "minimum": 0 },
              "normal": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              }
            }
          }
        },
        "area_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_area", "dominant_area_ratio", "bins"],
          "properties": {
            "total_area": { "type": "number", "minimum": 0 },
            "dominant_area_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "bins": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["range", "count"],
                "properties": {
                  "range": { "type": "string" },
                  "count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "normal_vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_normals"],
      "properties": {
        "dominant_normals": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cluster_id", "normal", "support_count"],
            "properties": {
              "cluster_id": { "type": "string" },
              "normal": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "support_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "proximity_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_distance_to_neighbors", "contact_candidates"],
      "properties": {
        "min_distance_to_neighbors": { "type": ["number", "null"], "minimum": 0 },
        "contact_candidates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "geometry_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings"],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
