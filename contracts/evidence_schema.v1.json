{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geometry_cognition/contracts/evidence_schema.v1.json",
  "title": "Evidence Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "evidence_type",
    "source_mcp",
    "source_object_ids",
    "claim",
    "observed_value",
    "confidence",
    "supports",
    "contradicts",
    "limitations"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "evidence_type": { "type": "string", "enum": ["geometry", "metadata", "relation", "derived"] },
    "source_mcp": { "type": "string", "minLength": 1 },
    "source_object_ids": { "type": "array", "items": { "type": "string" } },
    "claim": { "type": "string", "minLength": 1 },
    "observed_value": {},
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "supports": { "type": "array", "items": { "type": "string" } },
    "contradicts": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
