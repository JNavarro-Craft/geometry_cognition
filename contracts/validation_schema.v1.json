{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geometry_cognition/contracts/validation_schema.v1.json",
  "title": "Validation Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_id",
    "target_id",
    "rule_id",
    "rule_name",
    "status",
    "severity",
    "evidence",
    "recommendation",
    "skipped_reason"
  ],
  "properties": {
    "validation_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string", "minLength": 1 },
    "rule_name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pass", "fail", "skipped", "inconclusive"] },
    "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "type": ["string", "null"] },
    "skipped_reason": { "type": ["string", "null"] }
  }
}
